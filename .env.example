HOST=127.0.0.1
PORT=3008
# Set a long random service credential; never put it in a browser bundle.
VEYGRIT_CUSTOMS_API_KEY=
# Optional local-only development mode; requires HOST=127.0.0.1 or ::1.
ALLOW_UNAUTHENTICATED_LOOPBACK=false
# Optional Ollama model already installed by the operator. No model is downloaded.
VEYGRIT_AI_PROVIDER=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Optional reviewed tariff pack. Configure all three settings together.
VEYGRIT_TARIFF_DIR=
VEYGRIT_TARIFF_APPROVAL=
VEYGRIT_TARIFF_TRUSTED_KEYS=
# Optional operator-reviewed test records stored outside the repository.
VEYGRIT_LIVE_VALIDATION_FILE=
# Optional protected classification catalog and operator review history.
# An unset catalog uses bundled reference candidates; approval history defaults to empty.
VEYGRIT_CLASSIFICATION_CATALOG=
VEYGRIT_CLASSIFICATION_APPROVALS=
