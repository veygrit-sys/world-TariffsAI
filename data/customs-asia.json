{
  "pass": 2,
  "entries": [
    {
      "country": "AF",
      "status": "official_procedure",
      "sources": [
        {
          "url": "https://customs.mof.gov.af/?c=customs-procedures-dr",
          "authority": "Afghanistan Customs Department",
          "title": "Customs procedures and electronic declarations",
          "topic": "procedure"
        },
        {
          "url": "https://customs.mof.gov.af/700/",
          "authority": "Afghanistan Customs Department",
          "title": "Ministry of Finance remit for import and export tariff setting",
          "topic": "tariff"
        },
        {
          "url": "https://customs.mof.gov.af/?c=customs-tariffs-ps&s=pashto",
          "authority": "Afghanistan Customs Department",
          "title": "Customs tariff sections published in 1400 (2021)",
          "topic": "tariff"
        },
        {
          "url": "https://ttd.wto.org/en/profiles/afghanistan",
          "authority": "World Trade Organization",
          "title": "Afghanistan tariff profile, applied and bound statistics",
          "topic": "tariff"
        },
        {
          "url": "https://dpmea.gov.af/index.php/1405-English-News-97",
          "authority": "Afghanistan Deputy Prime Minister for Economic Affairs",
          "title": "Economic Commission meeting and proposed fixed import taxes",
          "topic": "tariff"
        }
      ],
      "guidance": [
        {
          "topic": "procedure",
          "textJa": "税関当局が公表する電子申告の手順とASYCUDAの価格評価手順を確認し、実際の提出先と必要書類を利用する税関で照合する。",
          "sourceUrls": [
            "https://customs.mof.gov.af/?c=customs-procedures-dr"
          ]
        },
        {
          "topic": "tariff",
          "textJa": "輸入税率の決定は財務省の所管。対象品目の適用税率は税関当局の現行決定で確認する。",
          "sourceUrls": [
            "https://customs.mof.gov.af/700/"
          ]
        },
        {
          "topic": "tariff",
          "textJa": "税関が公開した1400年（2021年）の章別資料とWTOの譲許税率・過去年の統計は参考資料。輸入日の適用税率と品目コードを利用する税関で照合する。",
          "sourceUrls": [
            "https://customs.mof.gov.af/?c=customs-tariffs-ps&s=pashto",
            "https://ttd.wto.org/en/profiles/afghanistan"
          ]
        },
        {
          "topic": "tariff",
          "textJa": "2026年11月9日の経済委員会の公表では、商業輸入事業者の固定税案は最終承認に付された段階。現行税率の根拠には採用せず、公布・施行を確認する。",
          "sourceUrls": [
            "https://dpmea.gov.af/index.php/1405-English-News-97"
          ]
        }
      ]
    },
    {
      "country": "BD",
      "status": "official_procedure",
      "sources": [
        {
          "url": "https://bangladeshcustoms.gov.bd/procedures/p_import/123",
          "authority": "Bangladesh Customs, National Board of Revenue",
          "title": "Import procedure and customs clearance",
          "topic": "procedure"
        },
        {
          "url": "https://nbr.gov.bd/budget/budget-at-a-glance/ban",
          "authority": "National Board of Revenue, Bangladesh",
          "title": "FY2026–27 budget and customs measures",
          "topic": "tariff"
        }
      ],
      "guidance": [
        {
          "topic": "procedure",
          "textJa": "運送側の輸入マニフェスト（IGM）登録を確認し、輸入者または通関代理人がASYCUDA Worldで輸入申告書（Bill of Entry）を提出する。",
          "sourceUrls": [
            "https://bangladeshcustoms.gov.bd/procedures/p_import/123"
          ]
        },
        {
          "topic": "tariff",
          "textJa": "NBRの2026–27年度資料で関税の変更と補足税等の措置を確認し、適用する品目番号と個別の発効日を照合する。",
          "sourceUrls": [
            "https://nbr.gov.bd/budget/budget-at-a-glance/ban"
          ]
        }
      ]
    },
    {
      "country": "BN",
      "status": "official_procedure",
      "sources": [
        {
          "url": "https://www.customs.gov.bn/import/",
          "authority": "Royal Customs and Excise Department of Brunei Darussalam",
          "title": "Import",
          "topic": "procedure"
        },
        {
          "url": "https://www.customs.gov.bn/ref-rced/",
          "authority": "Royal Customs and Excise Department of Brunei Darussalam",
          "title": "RCED reference documents",
          "topic": "tariff"
        }
      ],
      "guidance": [
        {
          "topic": "procedure",
          "textJa": "Brunei Darussalam National Single Window（BDNSW）で輸入申告を提出する。対象品には所管機関の許可の有無も確認する。",
          "sourceUrls": [
            "https://www.customs.gov.bn/import/"
          ]
        },
        {
          "topic": "tariff",
          "textJa": "品目番号と関税・物品税はBDTTCとその後の改正を別々に確認する。",
          "sourceUrls": [
            "https://www.customs.gov.bn/ref-rced/"
          ]
        }
      ]
    },
    {
      "country": "BT",
      "status": "official_procedure",
      "sources": [
        {
          "url": "https://mof.gov.bt/wp-content/uploads/2025/12/Customs-Rules-and-Regulations-of-Bhutan-Revised-Edition-2023.pdf",
          "authority": "Bhutan Ministry of Finance, Department of Revenue and Customs",
          "title": "Customs Rules and Regulations of Bhutan, revised edition 2023",
          "topic": "procedure"
        },
        {
          "url": "https://www.ecms.gov.bt/ECMSFE/login/indexBhutan.jsp",
          "authority": "Bhutan Department of Revenue and Customs",
          "title": "Electronic Customs Management System",
          "topic": "procedure"
        },
        {
          "url": "https://ecms.gov.bt/publication/btc-and-tariff-schedule",
          "authority": "Bhutan Department of Revenue and Customs",
          "title": "eCMS tariff publication index and linked 2022 edition",
          "topic": "tariff"
        }
      ],
      "guidance": [
        {
          "topic": "procedure",
          "textJa": "eCMSでの貨物申告に向けて、適用する輸入手続と必要書類を財務省の改訂規則で確認する。",
          "sourceUrls": [
            "https://mof.gov.bt/wp-content/uploads/2025/12/Customs-Rules-and-Regulations-of-Bhutan-Revised-Edition-2023.pdf"
          ]
        },
        {
          "topic": "procedure",
          "textJa": "eCMSの登録・申告状況照会機能を使用し、申告者の登録状況を事前に確認する。",
          "sourceUrls": [
            "https://www.ecms.gov.bt/ECMSFE/login/indexBhutan.jsp"
          ]
        },
        {
          "topic": "tariff",
          "textJa": "eCMSの一覧には2026年改正と記載されているが、リンク先PDFは2022年版の原本と一致する。申告に使う品目コードと税率は、税関に最新版と改正の適用日を確認する。",
          "sourceUrls": [
            "https://ecms.gov.bt/publication/btc-and-tariff-schedule"
          ]
        }
      ]
    },
    {
      "country": "CN",
      "status": "official_procedure",
      "sources": [
        {
          "url": "https://online.customs.gov.cn/static/pages/guides/000629002001/000629002001.html",
          "authority": "General Administration of Customs of the People's Republic of China",
          "title": "货物申报办事指南",
          "topic": "procedure"
        },
        {
          "url": "https://www.mofcom.gov.cn/zcfb/zgdwjjmywg/art/2025/art_8adbdacb40c84b2ca399988ce530b180.html",
          "authority": "General Administration of Customs of the People's Republic of China, published by MOFCOM",
          "title": "GACC Announcement No. 115 of 2025 on two-step declaration",
          "topic": "procedure"
        },
        {
          "url": "https://gss.mof.gov.cn/gzdt/zhengcefabu/202512/t20251231_3981044.htm",
          "authority": "Customs Tariff Commission of the State Council, Ministry of Finance",
          "title": "中华人民共和国进出口税则（2026）",
          "topic": "tariff"
        },
        {
          "url": "https://www.mofcom.gov.cn/cwxx/zcfb/art/2026/art_031306c35f494f64b3b4e259458bbc22.html",
          "authority": "Customs Tariff Commission of the State Council, published by MOFCOM",
          "title": "2026 tariff adjustment plan",
          "topic": "tariff"
        }
      ],
      "guidance": [
        {
          "topic": "procedure",
          "textJa": "中国本土の輸入貨物申告では荷受人または代理人の申告情報と関連書類を準備し、税関の貨物申告手続を確認する。",
          "sourceUrls": [
            "https://online.customs.gov.cn/static/pages/guides/000629002001/000629002001.html"
          ]
        },
        {
          "topic": "procedure",
          "textJa": "二段階申告を選ぶ場合は国際貿易シングルウィンドウ等で対象条件を確認し、選択した方式に沿って申告する。",
          "sourceUrls": [
            "https://www.mofcom.gov.cn/zcfb/zgdwjjmywg/art/2025/art_8adbdacb40c84b2ca399988ce530b180.html"
          ]
        },
        {
          "topic": "tariff",
          "textJa": "2026年1月1日施行の2026年版輸出入税則で品目番号を確認する。暫定税率や追加措置は別に照合する。",
          "sourceUrls": [
            "https://gss.mof.gov.cn/gzdt/zhengcefabu/202512/t20251231_3981044.htm"
          ]
        },
        {
          "topic": "tariff",
          "textJa": "2026年1月1日から適用される一部品目の税率・税目変更は、調整方案の添付表で対象と適用条件を確認する。",
          "sourceUrls": [
            "https://www.mofcom.gov.cn/cwxx/zcfb/art/2026/art_031306c35f494f64b3b4e259458bbc22.html"
          ]
        }
      ]
    },
    {
      "country": "HK",
      "status": "official_procedure",
      "sources": [
        {
          "url": "https://www.customs.gov.hk/en/service-enforcement-information/cargo-clearance/import-export-declaration/index.html",
          "authority": "Hong Kong Customs and Excise Department",
          "title": "Import and Export Declaration",
          "topic": "procedure"
        },
        {
          "url": "https://www.customs.gov.hk/en/service-enforcement-information/cargo-clearance/",
          "authority": "Hong Kong Customs and Excise Department",
          "title": "Cargo Clearance",
          "topic": "territory"
        },
        {
          "url": "https://www.customs.gov.hk/en/service-enforcement-information/trade-facilitation/dutiable-commodities/index.html",
          "authority": "Hong Kong Customs and Excise Department",
          "title": "Dutiable Commodities",
          "topic": "tax"
        }
      ],
      "guidance": [
        {
          "topic": "procedure",
          "textJa": "申告免除に当たらない貨物は輸入後14日以内の申告が案内されている。食品とその他で使用する様式を確認する。",
          "sourceUrls": [
            "https://www.customs.gov.hk/en/service-enforcement-information/cargo-clearance/import-export-declaration/index.html"
          ]
        },
        {
          "topic": "territory",
          "textJa": "香港は自由港で一般の輸出入関税を課さない。申告、対象品目の物品税および規制品の許可は個別に確認する。",
          "sourceUrls": [
            "https://www.customs.gov.hk/en/service-enforcement-information/cargo-clearance/"
          ]
        },
        {
          "topic": "tax",
          "textJa": "酒類、たばこ類、特定の炭化水素油、メチルアルコールについて、税・許可の対象区分と例外を確認する。",
          "sourceUrls": [
            "https://www.customs.gov.hk/en/service-enforcement-information/trade-facilitation/dutiable-commodities/index.html"
          ]
        }
      ]
    },
    {
      "country": "ID",
      "status": "official_procedure",
      "sources": [
        {
          "url": "https://beacukai.go.id/impor-untuk-dipakai",
          "authority": "Directorate General of Customs and Excise, Indonesia",
          "title": "Impor Untuk Dipakai",
          "topic": "procedure"
        },
        {
          "url": "https://www.beacukai.go.id/pemeriksaan-pabean",
          "authority": "Directorate General of Customs and Excise, Indonesia",
          "title": "Pemeriksaan Pabean",
          "topic": "procedure"
        },
        {
          "url": "https://jdih.kemenkeu.go.id/dok/pmk-68-tahun-2026/files",
          "authority": "Ministry of Finance of Indonesia",
          "title": "PMK 68 of 2026, fourth amendment of classification and import duty regulation",
          "topic": "tariff"
        }
      ],
      "guidance": [
        {
          "topic": "procedure",
          "textJa": "国内使用目的の輸入ではPIB（輸入貨物申告）を提出する。品名・数量・価格等を証明する関連書類を用意する。",
          "sourceUrls": [
            "https://beacukai.go.id/impor-untuk-dipakai"
          ]
        },
        {
          "topic": "procedure",
          "textJa": "税関の検査区分に応じて、書類提出や貨物の現物検査を手配する。",
          "sourceUrls": [
            "https://www.beacukai.go.id/pemeriksaan-pabean"
          ]
        },
        {
          "topic": "tariff",
          "textJa": "輸入品の分類・税率については規則26/PMK.010/2022と、2026年の第4次改正PMK 68の対象品目・発効条項を確認する。",
          "sourceUrls": [
            "https://jdih.kemenkeu.go.id/dok/pmk-68-tahun-2026/files"
          ]
        }
      ]
    },
    {
      "country": "IN",
      "status": "official_procedure",
      "sources": [
        {
          "url": "https://taxinformation.cbic.gov.in/content-page/explore-act/1000086/1000002",
          "authority": "Central Board of Indirect Taxes and Customs, India",
          "title": "Customs Act 1962, section 46",
          "topic": "procedure"
        },
        {
          "url": "https://www.icegate.gov.in/Webappl/index_imp.jsp",
          "authority": "Central Board of Indirect Taxes and Customs, India",
          "title": "ICEGATE Know your Import Duty Enquiry System",
          "topic": "tariff"
        }
      ],
      "guidance": [
        {
          "topic": "procedure",
          "textJa": "通過・積替え貨物を除く輸入では、国内消費または保税蔵置のBill of Entryを税関の自動化システムで電子提出する。",
          "sourceUrls": [
            "https://taxinformation.cbic.gov.in/content-page/explore-act/1000086/1000002"
          ]
        },
        {
          "topic": "tariff",
          "textJa": "ICEGATEでは品名や関税品目番号から輸入税を照会できる。適用を決める際は通達、原産地、税の適用条件を個別に確認する。",
          "sourceUrls": [
            "https://www.icegate.gov.in/Webappl/index_imp.jsp"
          ]
        }
      ]
    },
    {
      "country": "IR",
      "status": "official_reference",
      "sources": [
        {
          "url": "https://www.wipo.int/wipolex/en/legislation/details/14520",
          "authority": "World Intellectual Property Organization, WIPO Lex",
          "title": "Customs Law of Iran, IR037",
          "topic": "procedure"
        },
        {
          "url": "https://eec.eaeunion.org/upload/medialibrary/649/Guidance-on-the-Islamic-Republic-of-Iran-Trade-Regulation-2020.pdf",
          "authority": "Eurasian Economic Commission",
          "title": "Guidance on the Islamic Republic of Iran Trade Regulation 2020",
          "topic": "procedure"
        },
        {
          "url": "https://dotic.ir/p/legislativebranch/541",
          "authority": "Iran National Information Portal for Laws and Regulations",
          "title": "Iran Customs Administration circulars",
          "topic": "tariff"
        },
        {
          "url": "https://dotic.ir/news/22033",
          "authority": "Iran National Information Portal for Laws and Regulations",
          "title": "Iran Customs circular 1405/1181684 on goods eligible for percentage clearance",
          "topic": "procedure"
        }
      ],
      "guidance": [
        {
          "topic": "procedure",
          "textJa": "EECの2020年資料では電子申告と輸入書類の流れが掲載されている。実際の注文では申告経路の現行性と取引規制を個別に確認する。",
          "sourceUrls": [
            "https://eec.eaeunion.org/upload/medialibrary/649/Guidance-on-the-Islamic-Republic-of-Iran-Trade-Regulation-2020.pdf"
          ]
        },
        {
          "topic": "tariff",
          "textJa": "標準税率の照合時は、輸出入規則の税率表と税関通達の改正を品目別に確認する。2026年11月に公表された通達1405/1181684は、部分通関対象品目の追加に関する手続資料。",
          "sourceUrls": [
            "https://dotic.ir/p/legislativebranch/541",
            "https://dotic.ir/news/22033"
          ]
        }
      ]
    },
    {
      "country": "JP",
      "status": "official_procedure",
      "sources": [
        {
          "url": "https://www.customs.go.jp/english/summary/import.htm",
          "authority": "Japan Customs",
          "title": "Import Procedures",
          "topic": "procedure"
        },
        {
          "url": "https://www.customs.go.jp/english/c-answer_e/imtsukan/1107_e.htm",
          "authority": "Japan Customs",
          "title": "1107 Documents to be Submitted for Import Clearance",
          "topic": "procedure"
        },
        {
          "url": "https://www.customs.go.jp/english/tariff/2026_10_31/index.htm",
          "authority": "Japan Customs",
          "title": "Japan's Tariff Schedule as of October 31 2026",
          "topic": "tariff"
        }
      ],
      "guidance": [
        {
          "topic": "procedure",
          "textJa": "輸入申告後、税関の審査と必要な納税を経て輸入許可を受ける。貨物に応じて他法令の許可・承認も確認する。",
          "sourceUrls": [
            "https://www.customs.go.jp/english/summary/import.htm"
          ]
        },
        {
          "topic": "procedure",
          "textJa": "仕入書、運送書類、保険・運賃関係書類、包装明細書等を準備する。特恵を申請する場合は原産地の証明要件も確認する。",
          "sourceUrls": [
            "https://www.customs.go.jp/english/c-answer_e/imtsukan/1107_e.htm"
          ]
        },
        {
          "topic": "tariff",
          "textJa": "2026年10月31日時点の実行関税率表は、輸入統計品目番号と税率の参照に使う。注文の輸入日に対応する版と特別措置を確認する。",
          "sourceUrls": [
            "https://www.customs.go.jp/english/tariff/2026_10_31/index.htm"
          ]
        }
      ]
    },
    {
      "country": "KG",
      "status": "official_procedure",
      "sources": [
        {
          "url": "https://invest.gov.kg/en/invest-compass/taxes/customs",
          "authority": "National Investment Agency of the Kyrgyz Republic",
          "title": "Foreign Trade and Customs Regulation",
          "topic": "territory"
        },
        {
          "url": "https://eec.eaeunion.org/comission/department/catr/ett/",
          "authority": "Eurasian Economic Commission",
          "title": "Common Customs Tariff and commodity nomenclature",
          "topic": "tariff"
        }
      ],
      "guidance": [
        {
          "topic": "territory",
          "textJa": "EAEUの域内移動を判定するときは貨物が域内産またはEAEU貨物としての地位を有するか確認する。域外輸入では統一品目表と共通関税率表を参照する。",
          "sourceUrls": [
            "https://invest.gov.kg/en/invest-compass/taxes/customs"
          ]
        },
        {
          "topic": "tariff",
          "textJa": "EAEUの共通関税率表から該当品目を探し、キルギスの税・許可と該当する改正を確認する。",
          "sourceUrls": [
            "https://eec.eaeunion.org/comission/department/catr/ett/"
          ]
        }
      ]
    },
    {
      "country": "KH",
      "status": "official_procedure",
      "sources": [
        {
          "url": "https://cambodiantr.gov.kh/en/procedure/?title=submission-of-customs-declaration",
          "authority": "Cambodia National Trade Repository, General Department of Customs and Excise",
          "title": "Submission of Customs Declaration",
          "topic": "procedure"
        },
        {
          "url": "https://tools.customs.gov.kh/documents/reader/17709/17373560374410226/Manual%20on%20Customs%20Procedures%20in%20Cambodia%20%28English%29",
          "authority": "General Department of Customs and Excise of Cambodia",
          "title": "Manual on Customs Procedures in Cambodia",
          "topic": "procedure"
        },
        {
          "url": "https://cambodiantr.gov.kh/en/search-commodity/",
          "authority": "Cambodia National Trade Repository",
          "title": "Search Commodity",
          "topic": "tariff"
        }
      ],
      "guidance": [
        {
          "topic": "procedure",
          "textJa": "貨物所有者または認められた代理人がASYCUDAでSAD（統一行政文書）を提出し、窓口の添付書類の要件を確認する。",
          "sourceUrls": [
            "https://cambodiantr.gov.kh/en/procedure/?title=submission-of-customs-declaration"
          ]
        },
        {
          "topic": "procedure",
          "textJa": "申告前に利用システムの口座登録と、通関業者に委任する場合の資格・委任書類を確認する。",
          "sourceUrls": [
            "https://tools.customs.gov.kh/documents/reader/17709/17373560374410226/Manual%20on%20Customs%20Procedures%20in%20Cambodia%20%28English%29"
          ]
        },
        {
          "topic": "tariff",
          "textJa": "貿易リポジトリでHS番号または品名から該当品目の関税参照情報を調べる。",
