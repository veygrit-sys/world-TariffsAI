        },
        {
          "authority": "Biosecurity Authority of Fiji",
          "title": "Animals and animal products",
          "url": "https://www.baf.com.fj/animals-and-animal-products/",
          "topic": "restriction"
        }
      ],
      "guidance": [
        {
          "topic": "procedure",
          "textJa": "初回はFRCSのASYCUDA登録を確認し、商業インボイス、梱包明細、船荷証券または航空運送状をそろえる。ASYCUDA WorldでSADを提出し、対象品の許可を添付する。検査指示と納付を確認してから引取りを行う。",
          "sourceUrls": [
            "https://frcs.org.fj/our-services/customs/trade-business/importers/import-procedure/",
            "https://fijitradeportal.gov.fj/en-gb/super-process/step-detail?id=14"
          ]
        },
        {
          "topic": "restriction",
          "textJa": "動物・動物製品・植物・植物製品はBAFの許可システムで品目と輸出国を選び、必要な許可・証明・検査条件を確認する。医薬品は税関案内に従い保健当局の許可を照会する。",
          "sourceUrls": [
            "https://permit.baf.com.fj/",
            "https://www.baf.com.fj/download-forms/",
            "https://www.baf.com.fj/animals-and-animal-products/",
            "https://frcs.org.fj/our-services/customs/trade-business/importers/import-procedure/"
          ]
        }
