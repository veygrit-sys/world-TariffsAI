          "topic": "territory"
        },
        {
          "authority": "Guam Customs & Quarantine Agency",
          "title": "Resources and import requirements",
          "url": "https://cqa.guam.gov/resources/",
          "topic": "procedure"
        },
        {
          "authority": "Compiler of Laws, Judiciary of Guam",
          "title": "4 GAR, Customs, Agriculture, and Quarantine",
          "url": "https://col.guamcourts.gov/sites/default/files/04GAR001-2.pdf",
          "topic": "procedure"
        },
        {
          "authority": "Guam Department of Agriculture",
          "title": "Biosecurity and animal health contacts",
          "url": "https://doag.guam.gov/contact-us/",
          "topic": "restriction"
        }
      ],
      "guidance": [
        {
          "topic": "territory",
          "textJa": "グアムの貨物はGuam Customs & Quarantine Agency（CQA）が現地制度で処理する。米国本土の関税領域と区別し、利用港でCQAに書類提出先を確認する。",
          "sourceUrls": [
            "https://files.gao.gov/reports/GAO-26-107811/index.html",
            "https://cqa.guam.gov/resources/"
          ]
        },
        {
          "topic": "procedure",
          "textJa": "CQAの輸入要件と4 GARの貨物検査・報告手続を照合し、運送業者とマニフェストや貨物資料を準備する。",
          "sourceUrls": [
            "https://cqa.guam.gov/resources/",
            "https://col.guamcourts.gov/sites/default/files/04GAR001-2.pdf"
          ]
        },
        {
          "topic": "restriction",
          "textJa": "動物・動物製品はGuam Department of Agricultureに許可・健康証明の要件を確認し、植物その他の規制品はBiosecurityの窓口を確認する。",
          "sourceUrls": [
            "https://doag.guam.gov/contact-us/"
          ]
        }
      ]
    },
    {
